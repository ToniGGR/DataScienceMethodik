        <mxCell id="A2-2wJej60KvCBfdhlRf-5" value="&lt;div&gt;Schwächen:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Unerfahren&lt;/div&gt;&lt;div&gt;- kein Kapital vorhanden&lt;/div&gt;&lt;div&gt;- keine Erfahrung&lt;/div&gt;&lt;div&gt;- Teure Produkte&amp;nbsp;&lt;/div&gt;&lt;div&gt;- kleines Team&lt;/div&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
