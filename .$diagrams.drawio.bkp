        <mxCell id="A2-2wJej60KvCBfdhlRf-4" value="&lt;div&gt;Stärken:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Herstellerunabhängigkeit&lt;/div&gt;&lt;div&gt;- Viele Datenquellen&lt;/div&gt;&lt;div&gt;- First Mover am Markt&lt;/div&gt;&lt;div&gt;- Flexible Produktentwicklung&lt;/div&gt;&lt;div&gt;- Grenzkosten durch Abomodell relativ niedrig&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
