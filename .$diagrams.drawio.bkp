        </mxCell>
        <mxCell id="A2-2wJej60KvCBfdhlRf-8" value="&lt;div&gt;WO Strategie:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Kooperationen mit Automobilherstellern oder Forenseiten eingehen&lt;/div&gt;&lt;div&gt;- Produkte relativ billig anbieten sodass viele Nutzer auf die Plattform kommen&lt;/div&gt;&lt;div&gt;- Beschaffung von viel Fremdkapital oder Eigenkapital durch Investoren&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
